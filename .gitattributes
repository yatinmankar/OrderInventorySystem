# Normalize line endings across OSes. Windows scripts stay CRLF; everything the
# Linux containers read (sql) and shell scripts stay LF.
* text=auto eol=lf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
mvnw   text eol=lf
*.sql  text eol=lf
*.java text eol=lf
*.yml  text eol=lf
